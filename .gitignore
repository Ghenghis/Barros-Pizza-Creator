# Local build products. The one certified release DLL and its provenance are tracked.
artifacts/*
!artifacts/README.md
!artifacts/Barros.PizzaCreator.AI.dll
!artifacts/build-provenance.json
*.dll
!artifacts/Barros.PizzaCreator.AI.dll
*.pdb

# Python runtime state
**/__pycache__/
*.py[cod]
backend/data/conversation_history.json
backend/data/inspiration/
backend/settings.json

# Installed runtime trees must never be committed
BepInEx/
BarrosAI/

# Local diagnostics
Barros-AI-diagnostics-*.txt
evidence/runs/
releases/*.partial

# Unity 2021 authoring lab: keep source/configuration, never cache/editor state.
authoring/BarrosCreatorUiLab2021/[Ll]ibrary/
authoring/BarrosCreatorUiLab2021/[Tt]emp/
authoring/BarrosCreatorUiLab2021/[Oo]bj/
authoring/BarrosCreatorUiLab2021/[Ll]ogs/
authoring/BarrosCreatorUiLab2021/[Bb]uilds/
authoring/BarrosCreatorUiLab2021/[Uu]ser[Ss]ettings/
authoring/BarrosCreatorUiLab2021/MemoryCaptures/

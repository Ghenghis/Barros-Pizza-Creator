FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

RUN useradd --create-home --uid 10001 barros
COPY backend /app/backend
COPY contracts /app/contracts
RUN mkdir -p /app/assets/music /app/backend/data && chown -R barros:barros /app

USER barros
EXPOSE 48173
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import json,urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:48173/health',timeout=3))['ok']"
CMD ["python", "backend/main.py", "--host", "0.0.0.0", "--port", "48173"]

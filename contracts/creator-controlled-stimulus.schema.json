{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barros-pc3-creator-controlled-stimulus-v1",
  "title": "PC3 Pizza Creator controlled native JPEG research stimulus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "case_id", "runtime_profile", "model", "operation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 32},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "runtime_profile": {"const": "creator-0.11.272"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shape", "profit_factor", "placements"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 54},
        "shape": {"enum": ["Round", "Square", "Star", "Triangle"]},
        "profit_factor": {"type": "number", "minimum": 0.0, "maximum": 2.0},
        "placements": {
          "type": "array",
          "maxItems": 180,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ingredient_id", "size", "position", "rotation"],
            "properties": {
              "ingredient_id": {"type": "string", "minLength": 1},
              "size": {"enum": ["Large", "Medium", "Small"]},
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "z"],
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "z": {"type": "number"}
                }
              },
              "rotation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "z"],
                "properties": {
                  "x": {"type": "number"},
                  "y": {"type": "number"},
                  "z": {"type": "number"}
                }
              }
            }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_exact_model", "native_recipe_save", "reload_verify", "native_resave_after_reload"],
      "properties": {
        "preview_exact_model": {"type": "boolean"},
        "native_recipe_save": {"type": "boolean"},
        "reload_verify": {"type": "boolean"},
        "native_resave_after_reload": {"type": "boolean"}
      }
    },
    "notes": {"type": "string"}
  }
}

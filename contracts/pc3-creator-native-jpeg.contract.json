  "native_jpeg_export": {
    "entry_component": "UserInterface.ScreenshotButton",
    "capture_component": "ScreenCapture",
    "capture_api": "CaptureUtility.Capture",
    "camera_render": true,
    "source_width": 2560,
    "source_height": 1440,
    "resize_scale": 0.5,
    "output_width": 1280,
    "output_height": 720,
    "readback_texture_format": "RGB24",
    "render_texture_depth_bits": 24,
    "encoder": "Texture2D.EncodeToJPG",
    "jpeg_quality": 90,
    "output_directory": "Application.streamingAssetsPath/Screenshots",
    "filename_rule": "sanitized PizzaModel.ID plus _N.jpg",
    "maximum_concurrent_files_per_name": 5,
    "screenshot_only_ui_enabled_during_capture": true,
    "stock_button_disables_screenshot_only_ui_after_capture": true,
    "writes_encoder_bytes_directly": true,
    "custom_metadata_insertion": false,
    "custom_recipe_payload": false,
    "native_jpeg_to_editable_pizza_importer": false
  },
  "editable_recipe": {
    "entry_method": "IPizzaCreatorService.SaveCurrentPizzaToRecipes",
    "implementation_method": "PizzaCreatorServiceImpl.SaveToRecipes",
    "serializer": "ISerializerService.Serialize(PizzaModel)",
    "output_directory": "Application.persistentDataPath/UserData/Recipes",
    "filename_rule": "PizzaModel.ID plus .json",
    "serialized_fields": [
      "ID",
      "Ingredients",
      "DoughPositions",
      "ProfitFactor",
      "Owner",
      "Texture"
    ],
    "placement_fields": [
      "Ingredient",
      "IngredientID",
      "Rotation",
      "Position",
      "Size"
    ],
    "independent_from_jpeg_export": true
  },
  "mod_integration": {
    "preview_and_apply": "IPizzaCreatorService.LoadPizzaFromModel(PizzaModel)",
    "save": "IPizzaCreatorService.SaveCurrentPizzaToRecipes()",
    "reload_proof": "read persisted JSON, ISerializerService.DeserializeToObject<PizzaModel>, bind placements, resolve IngredientID and Size through IDatabaseService, then IPizzaCreatorService.LoadPizzaFromModel",
    "export": "stock ScreenCapture.Capture(string)",
    "export_ui_safety": "resolve the scene-local stock ScreenshotButton, enable its specialScreenshotUI during capture, then restore the prior active state in finally",
    "jpeg_reference_import": "AI vision may derive a new validated recipe; it is not a native lossless JPG round trip",
    "credentials_boundary": "provider credentials remain in the local sidecar and are never stored in the game or JPG"
  }
